# TrailPrint3D — environment configuration
# Copy this file to .env and fill in values for local development.
# All variables have working defaults for Docker Compose (see docker-compose.yml).

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker Compose default: redis://redis:6379/0
# Local dev default:      redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ── File storage ──────────────────────────────────────────────────────────────
# Where generated GLB / STL / OBJ / 3MF files are written.
# Docker Compose mounts this as a named volume.
# Local dev: any writable directory.
OUTPUT_DIR=/tmp/trailprint3d_output

# ── Blender ───────────────────────────────────────────────────────────────────
# Full path to the Blender 4.5.x executable.
# Docker image installs Blender 4.5.9 at /usr/local/bin/blender.
BLENDER_EXECUTABLE=/usr/local/bin/blender

# Full path to the headless generation script (relative to repo root: scripts/).
BLENDER_SCRIPT_PATH=/app/scripts/generate_terrain.py

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum GPX file size accepted by the API, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# ── Job timeouts ──────────────────────────────────────────────────────────────
# Wall-clock seconds before a preview job is killed (soft limit).
PREVIEW_TIMEOUT_SECONDS=120

# Wall-clock seconds before an export job is killed (soft limit).
# Export jobs (with OSM elements) can take 2-10 minutes.
EXPORT_TIMEOUT_SECONDS=600

# ── Celery worker ─────────────────────────────────────────────────────────────
# How many Blender processes one worker replica may run simultaneously.
# Keep this at 1 — Blender is memory-intensive and CPU-saturating.
# Scale concurrent jobs by adding more worker replicas instead.
CELERY_WORKER_CONCURRENCY=1

# ── Elevation API ─────────────────────────────────────────────────────────────
# Default elevation source used when the client does not specify one.
# Options: mapzen | opentopodata | open-elevation | opentopography
ELEVATION_DATA_SOURCE=mapzen

# ── OpenTopography API key (optional) ─────────────────────────────────────────
# Required only if users choose the OpenTopography elevation source.
# Free registration at https://portal.opentopography.org
# OPENTOPOGRAPHY_API_KEY=

# ── Flower task monitor (optional) ───────────────────────────────────────────
# Set to true to enable Celery Flower on port 5555 (add to docker-compose if needed).
FLOWER_ENABLED=false
