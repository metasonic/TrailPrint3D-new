# ─── TrailPrint3D Web App Configuration ───────────────────────────────────────
# Copy this file to .env and adjust values for your deployment.

# ─── Network ──────────────────────────────────────────────────────────────────
# Port the web app is exposed on (host port)
HTTP_PORT=8080

# CORS allowed origins (comma-separated, or * for any)
# For production, set this to your actual domain:
#   ALLOWED_ORIGINS=https://maps.yourdomain.com
ALLOWED_ORIGINS=*

# ─── Redis ────────────────────────────────────────────────────────────────────
# Redis connection URL (internal Docker service name)
REDIS_URL=redis://redis:6379/0

# ─── Storage ──────────────────────────────────────────────────────────────────
# Root data directory (inside container, mapped to a Docker volume)
TP3D_DATA_DIR=/data

# Uploaded GPX files directory
TP3D_UPLOAD_DIR=/data/uploads

# Generated output files directory (STL, OBJ, 3MF, GLB preview)
TP3D_OUTPUT_DIR=/data/outputs

# ─── Blender ──────────────────────────────────────────────────────────────────
# Path to the Blender binary inside the container
BLENDER_PATH=/usr/local/bin/blender

# Path to the addon directory (parent of the TrailPrint3D package)
BLENDER_ADDON_DIR=/app

# ─── Worker ───────────────────────────────────────────────────────────────────
# Number of concurrent Blender generation workers
# Each worker uses ~1-2GB RAM; adjust based on your server memory
CELERY_CONCURRENCY=2

# Max seconds a single generation job can run before timing out
CELERY_TASK_TIME_LIMIT=1800

# How many hours to keep job output files before cleanup (0 = never)
JOB_TTL_HOURS=24

# Maximum GPX upload file size in megabytes
MAX_UPLOAD_MB=50

# ─── Elevation API Keys ───────────────────────────────────────────────────────
# OpenTopography API key (required if using OpenTopography datasets)
# Get a free key at: https://portal.opentopography.org/requestApiKey
TP3D_OPENTOPOGRAPHY_KEY=

# Self-hosted OpenTopoData API URL (optional, overrides the public API)
# Must follow the OpenTopoData API format: https://api.opentopodata.org/v1/
OPENTOPODATA_SELF_HOSTED=

# ─── Cache ────────────────────────────────────────────────────────────────────
# Maximum number of cached elevation points
ELEVATION_CACHE_SIZE=50000
