# ─────────────────────────────────────────────────────────────────────────────
# TrailPrint3D — Environment Variable Reference
# Copy this file to .env and adjust values for your deployment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the backend API as seen by the browser (not the internal Docker network)
PUBLIC_API_URL=http://localhost:8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── File storage ─────────────────────────────────────────────────────────────
# Directory where uploads, previews, and exports are stored.
# Mount as a Docker volume for persistence.
OUTPUT_DIR=/app/data

# Directory for elevation tiles, OSM, and elevation caches.
CACHE_DIR=/app/.cache

# ── Blender ───────────────────────────────────────────────────────────────────
# Full path to the Blender executable inside the container.
BLENDER_EXECUTABLE_PATH=/opt/blender/blender

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Elevation data ────────────────────────────────────────────────────────────
# Default API used for elevation data.
# Options: TERRAIN-TILES | OPENTOPODATA | OPEN-ELEVATION | OPENTOPOGRAPHY
ELEVATION_DATA_SOURCE=TERRAIN-TILES

# Default terrain resolution (num_subdivisions). Range 1–8.
# Higher = more detail but slower. 4 is recommended for production.
TERRAIN_RESOLUTION=4

# OpenTopoData endpoint (can be self-hosted — must match opentopodata.org API format)
OPENTOPODATA_URL=https://api.opentopodata.org/v1/

# OpenTopography API key (required only when ELEVATION_DATA_SOURCE=OPENTOPOGRAPHY)
# Free key at https://portal.opentopography.org/
OPENTOPOGRAPHY_API_KEY=

# ── OSM / Overpass ────────────────────────────────────────────────────────────
# Overpass API endpoint. Use a self-hosted instance for better rate limits.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Caching ───────────────────────────────────────────────────────────────────
# Maximum age of cached Overpass/elevation data in hours (default: 720 = 30 days)
CACHE_MAX_AGE_HOURS=720

# Maximum number of elevation points stored in the in-memory/disk cache
ELEVATION_CACHE_SIZE=50000
