---
import TrailPrintApp from "../components/TrailPrintApp";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TrailPrint3D — GPX to 3D Print</title>
  <meta name="description" content="Convert your GPS trail into a 3D-printable terrain map." />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0d1a;
      --surface: #14142a;
      --surface2: #1c1c36;
      --accent: #2563eb;   /* darkened from #4f8ef7 — contrast with white: 5.9:1 ✓ */
      --accent2: #8b5cf6;
      --trail: #dc3232;
      --text: #e0e0f0;
      --muted: #8888a8;    /* lightened from #6b6b8a — contrast on --surface: ~5.5:1 ✓ */
      --border: #2a2a4a;
      --success: #15803d;  /* darkened from #22c55e — contrast with white: 5.0:1 ✓ */
      --error: #ef4444;
      --radius: 10px;
    }

    html, body { height: 100%; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, sans-serif; font-size: 14px; }

    /* ── Skip navigation link (visually hidden until focused) ── */
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 9999;
      padding: 0.5rem 1rem;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      border-radius: 0 0 var(--radius) var(--radius);
      text-decoration: none;
    }
    .skip-link:focus { left: 0; }

    /* ── Keyboard focus indicator ── */
    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 3px;
    }

    /* App grid */
    .app-grid {
      display: grid;
      grid-template-columns: 300px 1fr;
      grid-template-rows: 1fr auto;
      height: 100vh;
      gap: 0;
    }
    .sidebar {
      grid-row: 1 / 3;
      background: var(--surface);
      border-right: 1px solid var(--border);
      overflow-y: auto;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .preview-area {
      background: var(--bg);
      height: 100%;
      min-height: 0;
    }
    .download-panel {
      background: var(--surface2);
      border-top: 1px solid var(--border);
      padding: 0.75rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    /* Header */
    .app-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.25rem;
    }
    .app-header h1 { font-size: 1.1rem; font-weight: 700; color: #60a5fa; /* blue-400: ~8:1 on --surface */ }
    .app-header span { font-size: 0.75rem; color: var(--muted); }

    /* Upload zone */
    .upload-zone {
      border: 2px dashed var(--border);
      border-radius: var(--radius);
      padding: 1.5rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }
    .upload-zone:hover, .upload-zone.dragging { border-color: var(--accent); background: rgba(79,142,247,0.05); }
    .upload-zone.has-file { border-style: solid; border-color: var(--success); }
    .upload-icon { width: 36px; height: 36px; color: var(--muted); }
    .upload-stats { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.85rem; }
    .upload-stats strong { color: #4ade80; /* green-400: ~7:1 on --surface */ }
    .muted { color: var(--muted); font-size: 0.8rem; }

    /* Settings groups */
    .settings-group {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .settings-group summary {
      padding: 0.6rem 0.75rem;
      cursor: pointer;
      font-weight: 600;
      background: var(--surface2);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      user-select: none;
    }
    .settings-group summary::-webkit-details-marker { display: none; }
    .settings-group summary::before { content: "▶"; font-size: 0.6rem; color: var(--muted); transition: transform 0.15s; }
    .settings-group[open] summary::before { transform: rotate(90deg); }
    .settings-group > *:not(summary) {
      padding: 0.5rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.8rem;
      color: var(--muted);
    }
    label > span { color: var(--text); font-size: 0.85rem; }
    input[type="number"], select {
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 0.35rem 0.5rem;
      font-size: 0.85rem;
      width: 100%;
    }
    input[type="range"] { width: 100%; accent-color: var(--accent); }
    input[type="checkbox"] { accent-color: var(--accent); width: auto; }
    label:has(input[type="checkbox"]) {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      color: var(--text);
      cursor: pointer;
    }
    .badge {
      margin-left: auto;
      font-size: 0.65rem;
      background: rgba(139,92,246,0.2);
      color: #c4b5fd; /* purple-300: ~9:1 on --surface2 */
      padding: 0.1rem 0.4rem;
      border-radius: 20px;
      font-weight: 500;
    }

    /* Buttons */
    .btn-primary {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: var(--radius);
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      transition: opacity 0.15s;
    }
    .btn-primary:hover { opacity: 0.85; }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Export buttons */
    .export-buttons { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .export-buttons > span { font-weight: 600; color: var(--muted); font-size: 0.8rem; }
    .btn-export {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      padding: 0.45rem 1rem;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      transition: border-color 0.15s, background 0.15s;
    }
    .btn-export.active, .btn-export:hover { border-color: var(--accent); background: rgba(79,142,247,0.1); }
    .btn-export:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-download {
      display: inline-block;
      margin-left: 0.5rem;
      background: var(--success);
      color: #fff;
      border-radius: 8px;
      padding: 0.4rem 0.8rem;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
    }

    /* Job status */
    .job-status { display: flex; align-items: center; gap: 0.75rem; flex: 1; flex-wrap: wrap; }
    .progress-bar { height: 6px; width: 160px; background: var(--border); border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 3px; transition: width 0.3s; background: var(--accent); }
    .progress-fill.done { background: var(--success); }
    .progress-fill.failed { background: var(--error); }
    .progress-label { font-size: 0.8rem; color: var(--muted); }

    /* Error box */
    .error-box {
      background: rgba(239,68,68,0.1);
      border: 1px solid var(--error);
      color: #f87171; /* red-400: ~6:1 on tinted dark bg — exceeds 4.5:1 */
      border-radius: var(--radius);
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
    }

    /* Spinner */
    .spinner {
      display: inline-block;
      width: 18px; height: 18px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Respect user motion preference — disable looping animations */
    @media (prefers-reduced-motion: reduce) {
      .spinner { animation: none; border-top-color: #fff; opacity: 0.8; }
      .progress-fill { transition: none; }
    }

    /* Responsive */
    @media (max-width: 680px) {
      .app-grid { grid-template-columns: 1fr; grid-template-rows: auto 300px auto; }
      .sidebar { grid-row: 1; height: auto; overflow-y: visible; }
      .preview-area { grid-row: 2; }
      .download-panel { grid-row: 3; }
    }
  </style>
</head>
<body>
  <!-- Skip navigation: allows keyboard users to jump past sidebar controls -->
  <a href="#main-content" class="skip-link">Skip to 3D preview</a>

  <!--
    <main> is in the static HTML shell so landmark navigation is available
    before and during React hydration (not just after client:load fires).
  -->
  <main id="main-content">
    <TrailPrintApp client:load />
  </main>
</body>
</html>
