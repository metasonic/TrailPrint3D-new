---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';
---

<Layout title="TrailPrint3D Web">
	<main class="h-screen w-full flex flex-col bg-gray-50">
		<header class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-4 shadow-lg flex justify-between items-center z-10 relative">
			<div class="flex items-center space-x-3">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				<div>
					<h1 class="text-xl font-bold tracking-wide">TrailPrint3D</h1>
					<div class="text-xs text-blue-200 font-medium tracking-wider uppercase">Self-Hosted Processing Engine</div>
				</div>
			</div>
		</header>
		<div class="flex-grow overflow-hidden relative">
			<App client:only="react" />
		</div>
	</main>
</Layout>
