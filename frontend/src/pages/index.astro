---
import TrailPrintApp from "../components/TrailPrintApp";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>TrailPrint3D — GPX to 3D Print</title>
  <meta name="description" content="Convert your GPS trail into a 3D-printable terrain map." />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0d0d1a;
      --surface: #14142a;
      --surface2: #1c1c36;
      --accent: #2563eb;   /* darkened from #4f8ef7 — contrast with white: 5.9:1 ✓ */
      --accent2: #8b5cf6;
      --trail: #dc3232;
      --text: #e0e0f0;
      --muted: #8888a8;    /* lightened from #6b6b8a — contrast on --surface: ~5.5:1 ✓ */
      --border: #676787;   /* lightened: 3.6:1 vs --surface — meets WCAG 1.4.11 UI boundary */
      --success: #15803d;  /* darkened from #22c55e — contrast with white: 5.0:1 ✓ */
      --error: #ef4444;
      --radius: 10px;
    }

    /* 0.9375rem = 15px at browser default 16px, but scales with user font-size preferences */
    html, body { height: 100%; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, sans-serif; font-size: 0.9375rem; }

    /* ── Visually hidden but screen-reader accessible ── */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    /* ── Skip navigation link (visually hidden until focused) ── */
    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 9999;
      padding: 0.5rem 1rem;
      background: var(--accent);
      color: #fff;
      font-weight: 700;
      border-radius: 0 0 var(--radius) var(--radius);
      text-decoration: none;
    }
    .skip-link:focus { left: 0; }

    /* ── Keyboard focus indicator ── */
    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
      border-radius: 3px;
    }

    /* App grid */
    .app-grid {
      display: grid;
      grid-template-columns: 300px 1fr;
      grid-template-rows: 1fr auto;
      height: 100dvh; /* 100dvh: excludes mobile browser chrome (iOS safe area fix) */
      gap: 0;
    }
    .sidebar {
      grid-row: 1 / 3;
      background: var(--surface);
      border-right: 1px solid var(--border);
      overflow-y: auto;
      overscroll-behavior: contain; /* prevent scroll chaining to page / pull-to-refresh */
      padding: 1rem;
      /* Safe area inset for notch devices (no-op on desktop) */
      padding-top: max(1rem, env(safe-area-inset-top));
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .preview-area {
      background: var(--bg);
      height: 100%;
      min-height: 0;
    }
    .download-panel {
      background: var(--surface2);
      border-top: 1px solid var(--border);
      padding: 0.75rem 1.25rem;
      /* Safe area insets for home indicator + landscape notch */
      padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
      padding-left: max(1.25rem, env(safe-area-inset-left));
      padding-right: max(1.25rem, env(safe-area-inset-right));
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      min-height: 52px;
    }

    /* Header */
    .app-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
      margin-bottom: 0.25rem;
    }
    .app-header h1 { font-size: 1.25rem; font-weight: 700; color: #60a5fa; /* blue-400: ~8:1 on --surface */ }
    .app-header span { font-size: 0.8rem; font-weight: 500; color: var(--muted); }

    /* Upload zone */
    .upload-zone {
      border: 2px dashed var(--border);
      border-radius: var(--radius);
      padding: 1.5rem 1rem;
      text-align: center;
      cursor: pointer;
      /* Animate border-color, background, and height collapse smoothly */
      transition: border-color 0.15s, background 0.15s, min-height 0.2s;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }
    .upload-zone:hover { border-color: var(--accent); background: rgba(37,99,235,0.05); }
    .upload-zone.dragging { border-color: var(--accent); background: rgba(37,99,235,0.14); border-style: solid; }
    .upload-zone.has-file { border-style: solid; border-color: var(--success); min-height: 80px; padding: 0.75rem 1rem; }
    /* Uses global --accent ring — consistent with all other focusable elements */
    .upload-icon { width: 36px; height: 36px; color: var(--muted); }
    .upload-stats { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.85rem; }
    .upload-stats strong { color: #4ade80; /* green-400: ~7:1 on --surface */ }
    .muted { color: var(--muted); font-size: 0.8rem; }

    /* Settings groups */
    .settings-group {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .settings-group summary {
      padding: 0.75rem;
      min-height: 44px;
      cursor: pointer;
      font-weight: 600;
      background: var(--surface2);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      user-select: none;
    }
    .settings-group summary::-webkit-details-marker { display: none; }
    .settings-group summary::before { content: "▶"; font-size: 0.7rem; color: var(--muted); transition: transform 0.15s; }
    .settings-group[open] summary::before { transform: rotate(90deg); }
    .settings-group > *:not(summary) {
      padding: 0.5rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem; /* increased from 0.4rem — reduces cramped stacking of form rows */
    }
    label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.867rem; /* ~13px at base — keeps labels above 12px floor */
      color: var(--text);
    }
    label > span { color: var(--text); font-size: 0.867rem; }
    input[type="number"], input[type="text"], select {
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 6px;
      padding: 0.35rem 0.5rem;
      /* 16px minimum prevents iOS Safari auto-zoom on focus */
      font-size: 16px;
      width: 100%;
    }
    input[type="range"] { width: 100%; accent-color: var(--accent); }
    input[type="checkbox"] { accent-color: var(--accent); width: auto; }
    label:has(input[type="checkbox"]) {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      color: var(--text);
      cursor: pointer;
      min-height: 44px;
      padding: 0.25rem 0;
    }
    .badge {
      margin-left: auto;
      font-size: 0.875rem; /* 14px at default — above 12px floor with zoom tolerance */
      background: rgba(139,92,246,0.2);
      color: #c4b5fd; /* purple-300: ~9:1 on --surface2 */
      padding: 0.1rem 0.4rem;
      border-radius: 20px;
      font-weight: 500;
    }

    /* Buttons */
    .btn-primary {
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: var(--radius);
      padding: 0.7rem 1rem;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      min-height: 44px;
      transition: background 0.15s;
    }
    .btn-primary:hover { background: #1d4ed8; /* blue-700: white contrast 7.3:1 ✓ */ }
    .btn-primary[disabled], .btn-primary[aria-disabled="true"] { opacity: 0.65; cursor: not-allowed; }
    .btn-primary:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    /* Export Generate button overrides: auto width, matches btn-export height */
    .btn-generate-export { width: auto; padding: 0.55rem 1.25rem; }

    /* Export buttons / radio group */
    .export-buttons { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .export-format-group { border: none; padding: 0; margin: 0; display: contents; }
    .btn-export {
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      padding: 0.45rem 1rem;
      min-height: 44px;
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 600;
      transition: border-color 0.15s, background 0.15s;
    }
    /* Active (selected format) has stronger tint + inset indicator */
    .btn-export[aria-checked="true"] {
      border-color: var(--accent);
      background: rgba(37,99,235,0.18);
      box-shadow: inset 0 -2px 0 var(--accent);
    }
    /* Hover on non-active buttons: lighter tint */
    .btn-export:hover:not([aria-checked="true"]) { border-color: var(--accent); background: rgba(37,99,235,0.08); }
    .btn-export[disabled] { opacity: 0.5; cursor: not-allowed; }
    .btn-download {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      background: var(--success);
      color: #fff;
      border-radius: 8px;
      padding: 0.4rem 0.8rem;
      min-height: 44px;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      transition: background 0.15s;
      max-width: 240px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    /* #166534 (green-800): white text contrast ~5.4:1 — exceeds WCAG AA ✓ */
    .btn-download:hover { background: #166534; }
    .btn-download:focus-visible {
      outline: 2px solid #4ade80;
      outline-offset: 3px;
    }

    /* Job status */
    .job-status { display: flex; align-items: center; gap: 0.75rem; flex: 1; flex-wrap: wrap; }
    .progress-bar { height: 6px; min-width: 160px; flex: 1; max-width: 280px; flex-shrink: 0; background: #2a2a48; border-radius: 3px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 3px; transition: width 0.3s; background: var(--accent); }
    .progress-fill.done { background: var(--success); }
    .progress-fill.failed { background: var(--error); }
    .progress-label { font-size: 0.8rem; color: var(--muted); }
    /* #f87171 (red-400): 5.98:1 on --surface2 — meets WCAG AA at 12px */
    .progress-label--error { color: #f87171; }

    /* Error box */
    .error-box {
      background: rgba(239,68,68,0.1);
      border: 1px solid var(--error);
      color: #f87171; /* red-400: ~6:1 on tinted dark bg — exceeds 4.5:1 */
      border-radius: var(--radius);
      padding: 0.5rem 0.75rem;
      font-size: 0.8rem;
      line-height: 1.5;
    }

    /* Spinner */
    .spinner {
      display: inline-block;
      width: 18px; height: 18px;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Respect user motion preference — replace rotation with a static "⋯" indicator */
    @media (prefers-reduced-motion: reduce) {
      .spinner { animation: none; border: none; width: auto; height: auto; font-size: 1.2rem; letter-spacing: 0.1em; opacity: 0.9; }
      .spinner::before { content: "⋯"; }
      .progress-fill { transition: none; }
    }

    /* Tablet: tighten sidebar column so preview gets more room */
    @media (min-width: 681px) and (max-width: 900px) {
      .app-grid { grid-template-columns: 240px 1fr; }
    }

    /* Mobile (portrait) */
    @media (max-width: 680px) {
      .app-grid {
        grid-template-columns: 1fr;
        /* Use viewport-relative height so the preview is usable on portrait phones */
        grid-template-rows: auto min(65vw, 400px) auto;
      }
      .sidebar { grid-row: 1; height: auto; max-height: 60vh; overflow-y: auto; }
      .preview-area { grid-row: 2; }
      .download-panel {
        grid-row: 3;
        flex-direction: column;
        align-items: stretch;
      }
      .export-buttons { flex-wrap: wrap; }
      .btn-export { flex: 1; text-align: center; }
      .btn-generate-export { flex: 1; }
      .progress-bar { max-width: none; }
    }

    /* Mobile landscape: shorter sidebar + tighter preview */
    @media (max-width: 680px) and (orientation: landscape) {
      .app-grid { grid-template-rows: auto min(40vh, 280px) auto; }
      .sidebar { max-height: 35vh; }
    }
  </style>
</head>
<body>
  <!-- Skip navigation: allows keyboard users to jump past sidebar controls -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!--
    <main> is in the static HTML shell so landmark navigation is available
    before and during React hydration (not just after client:load fires).
  -->
  <main id="main-content">
    <TrailPrintApp client:load />
    <noscript>
      <div style="display:flex;align-items:center;justify-content:center;height:100vh;padding:2rem;text-align:center;color:#e0e0f0;background:#0d0d1a;font-family:system-ui,sans-serif;">
        <p>TrailPrint3D requires JavaScript to run. Please enable JavaScript in your browser settings.</p>
      </div>
    </noscript>
  </main>
</body>
</html>
